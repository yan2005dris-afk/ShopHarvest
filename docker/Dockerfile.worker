# syntax=docker/dockerfile:1.4

# ─── Stage: Base ──────────────────────────────────────────────────────────────
FROM node:22-alpine AS base

RUN apk add --no-cache chromium nss freetype harfbuzz ca-certificates ttf-freefont

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=true
ENV CRAWLEE_HEADLESS=true
RUN corepack enable && corepack prepare pnpm@11 --activate

WORKDIR /app

# ─── Stage: Builder ───────────────────────────────────────────────────────────
FROM base AS builder

COPY pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm fetch

COPY package.json ./
COPY worker/package.json ./worker/
RUN pnpm install --frozen-lockfile --offline

COPY worker/ ./worker/
RUN pnpm --filter worker run build

RUN pnpm deploy --filter=worker --prod --legacy /prod/worker

# ─── Stage: Runner ────────────────────────────────────────────────────────────
FROM base AS runner

WORKDIR /app

COPY --chown=node:node --from=builder /prod/worker/node_modules ./node_modules
COPY --chown=node:node --from=builder /prod/worker/package.json ./package.json
COPY --chown=node:node --from=builder /app/worker/dist ./dist

USER node

CMD ["node", "dist/consumer.js"]
