# syntax=docker/dockerfile:1.4

# ─── Stage: Base ──────────────────────────────────────────────────────────────
FROM node:22-bookworm-slim AS base

# Install Firefox dependencies for Camoufox
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgtk-3-0 \
    libdbus-glib-1-2 \
    libxt6 \
    libx11-xcb1 \
    libxcb-shm0 \
    libx11-6 \
    libxrender1 \
    libxext6 \
    libxrandr2 \
    libxcomposite1 \
    libxcursor1 \
    libxdamage1 \
    libxfixes3 \
    libxi6 \
    libxtst6 \
    libfontconfig1 \
    libpangocairo-1.0-0 \
    libpango-1.0-0 \
    libcairo2 \
    libasound2 \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=true
ENV CRAWLEE_HEADLESS=true
RUN corepack enable && corepack prepare pnpm@11 --activate

WORKDIR /app

# ─── Stage: Builder ───────────────────────────────────────────────────────────
FROM base AS builder

COPY pnpm-lock.yaml pnpm-workspace.yaml package.json .npmrc ./
COPY worker/package.json ./worker/

RUN pnpm install --frozen-lockfile

# Fetch Camoufox binary (Firefox fork)
RUN cd worker && npx camoufox-js fetch

COPY worker/ ./worker/
RUN pnpm --filter worker run build

RUN pnpm deploy --filter=worker --prod --legacy /prod/worker

# Copy camoufox binary to production folder (it's stored in worker/node_modules/camoufox-js/...)
# Or better, we ensure it's in a shared location. camoufox-js stores it in ~/.cache/camoufox usually
# Actually, npx camoufox-js fetch downloads to a specific folder. 
# Let's check where it puts it.

# ─── Stage: Runner ────────────────────────────────────────────────────────────
FROM base AS runner

WORKDIR /app

COPY --chown=node:node --from=builder /prod/worker/node_modules ./node_modules
COPY --chown=node:node --from=builder /prod/worker/package.json ./package.json
COPY --chown=node:node --from=builder /app/worker/dist ./dist
# Copy the downloaded Camoufox binary and GeoIP DB
COPY --chown=node:node --from=builder /root/.cache/camoufox /home/node/.cache/camoufox

RUN mkdir -p /app/storage && chown node:node /app/storage

# Set HOME so camoufox finds the cache
ENV HOME=/home/node
USER node

CMD ["node", "dist/consumer.js"]
