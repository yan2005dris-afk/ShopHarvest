# syntax=docker/dockerfile:1.4

# ─── Stage: Base ──────────────────────────────────────────────────────────────
FROM node:22-alpine AS base

RUN apk add --no-cache openssl libc6-compat

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
ENV PNPM_CONFIG_PACKAGE_IMPORT_METHOD=copy \
    PNPM_CONFIG_FETCH_RETRIES=5 \
    PNPM_CONFIG_FETCH_RETRY_MAXTIMEOUT=120000 \
    PNPM_CONFIG_FETCH_TIMEOUT=300000
ENV PRISMA_SKIP_POSTINSTALL_GENERATE=true
ENV SCARF_NO_ANALYTICS=true
ENV DO_NOT_TRACK=1
RUN corepack enable && corepack prepare pnpm@11 --activate

WORKDIR /app

# ─── Stage: Installer ─────────────────────────────────────────────────────────
FROM base AS installer

# Copy workspace manifests, config, and ALL workspace package.json files
# so pnpm can resolve workspace dependencies (especially @web-scraping/contracts)
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json .npmrc ./
COPY backend/package.json ./backend/
COPY frontend/package.json ./frontend/
COPY packages/contracts/package.json ./packages/contracts/

# pnpm 11 requires build-script approval for packages with postinstall hooks.
# --frozen-lockfile + --ignore-scripts lets us install with the locked
# resolution while deferring the allowed builds to a separate step.
RUN --mount=type=cache,id=pnpm,target=/pnpm/store pnpm install --frozen-lockfile --ignore-scripts

# Re-run only the approved build scripts (same list as pnpm.onlyBuiltDependencies
# in package.json). @scarf/scarf is intentionally excluded — it is telemetry-only
# and its absence does not affect swagger-ui-dist at runtime.
RUN pnpm rebuild @nestjs/core @parcel/watcher @prisma/engines better-sqlite3 esbuild lmdb msgpackr-extract playwright prisma sharp unrs-resolver

# ─── Stage: Builder ───────────────────────────────────────────────────────────
FROM installer AS builder

COPY packages/contracts/ ./packages/contracts/
RUN pnpm --filter @web-scraping/contracts run build

COPY backend/ ./backend/
COPY packages/contracts/ ./packages/contracts/

# Build shared contracts package BEFORE backend (backend depends on it)
RUN pnpm --filter @web-scraping/contracts run build

# Generate Prisma clients for both databases (used at build time for type-checking)
RUN pnpm --filter backend exec prisma generate --config prisma.operational.config.ts
RUN pnpm --filter backend exec prisma generate --config prisma.analytics.config.ts
RUN pnpm --filter backend run build

# Deploy: extract flat production node_modules (no symlinks, Docker-safe)
RUN pnpm deploy --filter=backend --prod --legacy /prod/backend

# ─── Stage: Runner ────────────────────────────────────────────────────────────
FROM base AS runner

WORKDIR /app

COPY --from=builder /prod/backend/node_modules ./node_modules
COPY --from=builder /prod/backend/package.json ./package.json
# Keep the workspace contracts package available at its expected path so the
# deployed layout's relative symlink (node_modules/@web-scraping/contracts ->
# /app/packages/contracts) resolves at runtime for CommonJS subpath requires.
COPY --from=builder /app/packages/contracts ./packages/contracts
COPY --from=builder /app/backend/dist ./dist
COPY --from=builder /app/backend/prisma ./prisma
COPY --from=builder /app/backend/prisma.operational.config.ts ./prisma.operational.config.ts
COPY --from=builder /app/backend/prisma.analytics.config.ts ./prisma.analytics.config.ts

# Generate Prisma clients at build time against the deployed flat node_modules
# so runtime imports (e.g. @prisma/client-runtime-utils) resolve correctly.
RUN npx prisma generate --config prisma.operational.config.ts && \
    npx prisma generate --config prisma.analytics.config.ts

# Copy generated clients into dist/ so the compiled JS resolves them
RUN cp -r src/generated dist/generated

# Create pipeline directories and assign ownership to node user
RUN mkdir -p pipeline/raw pipeline/staging && chown -R node:node pipeline

# Install Playwright's Chromium so the ETL scrape adapters (MercadoLibre,
# AliExpress) can launch a real browser at runtime. The base image is Alpine,
# which Playwright does not officially support — `install --with-deps` would
# fall back to Ubuntu's apt deps and fail (exit 127). Instead download the
# browser binary and install the required shared libraries via apk. The runner
# uses the `node` user with HOME=/home/node, so point PLAYWRIGHT_BROWSERS_PATH
# there and pre-create the cache dir with ownership.
ENV PLAYWRIGHT_BROWSERS_PATH=/home/node/.cache/ms-playwright
RUN mkdir -p "$PLAYWRIGHT_BROWSERS_PATH" && chown -R node:node /home/node/.cache && \
    npx playwright install chromium && \
    apk add --no-cache \
      glib \
      nspr \
      nss \
      libatk-1.0 \
      at-spi2-core \
      dbus-libs \
      expat \
      libx11 \
      libxcomposite \
      libxdamage \
      libxext \
      libxfixes \
      libxrandr \
      libxcb \
      libxkbcommon \
      libxrender \
      libxi \
      libxtst \
      mesa-gbm \
      alsa-lib \
      libudev-zero \
      gtk+3.0 \
      fontconfig \
      ttf-liberation \
      && chown -R node:node "$PLAYWRIGHT_BROWSERS_PATH"

USER node
EXPOSE 3000

# Run migrations for both databases before starting the app.
# Use npx prisma to avoid corepack-permission issues (node user cannot download pnpm).
# Analytics moved from `db push` to `migrate deploy` (fix-analytics-db-wiring):
# the analytics DB now has a tracked migration history (dw schema + views +
# materialized view), so it deploys the same way the operational DB does.
CMD ["sh", "-c", "./node_modules/.bin/prisma migrate deploy --config prisma.operational.config.ts && ./node_modules/.bin/prisma migrate deploy --config prisma.analytics.config.ts && node dist/main.js"]
