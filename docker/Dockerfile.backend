# syntax=docker/dockerfile:1.4

# ─── Stage: Base ──────────────────────────────────────────────────────────────
FROM node:22-alpine AS base

RUN apk add --no-cache openssl libc6-compat

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
ENV PNPM_CONFIG_PACKAGE_IMPORT_METHOD=copy
ENV PRISMA_SKIP_POSTINSTALL_GENERATE=true
RUN corepack enable && corepack prepare pnpm@11 --activate

WORKDIR /app

# ─── Stage: Builder ───────────────────────────────────────────────────────────
FROM base AS builder

# Cache layers: lockfile first
COPY pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm fetch

# Manifests
COPY package.json ./
COPY backend/package.json ./backend/

# Install (offline — uses virtual store from pnpm fetch)
RUN pnpm install --frozen-lockfile --offline

# Source
COPY backend/ ./backend/

# Generate Prisma client and build NestJS
RUN pnpm --filter backend exec prisma generate
RUN pnpm --filter backend run build

# Extract prod deps into standalone dir
RUN pnpm deploy --filter=backend --prod --legacy /prod/backend

# ─── Stage: Runner ────────────────────────────────────────────────────────────
FROM node:22-alpine AS runner

RUN apk add --no-cache openssl libc6-compat

WORKDIR /app

COPY --chown=node:node --from=builder /prod/backend/node_modules ./node_modules
COPY --chown=node:node --from=builder /prod/backend/package.json ./package.json
COPY --chown=node:node --from=builder /app/backend/dist ./dist
COPY --chown=node:node --from=builder /app/backend/prisma ./prisma

USER node
EXPOSE 3000

CMD ["sh", "-c", "node_modules/.bin/prisma migrate deploy && node dist/main.js"]
