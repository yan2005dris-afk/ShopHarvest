# syntax=docker/dockerfile:1.4
#
# Frontend production image (Angular + Nginx).
#
# Output: nginx:1.27-alpine serving the compiled Angular SPA at /usr/share/nginx/html.
# The nginx config (docker/nginx.frontend.conf) handles both the SPA fallback
# AND the /api/* proxy to the backend container, so the same image works in:
#   - DEV: browser hits http://localhost:8080 → internal nginx proxies /api/*
#   - PROD: Cloudflare Tunnel routes traffic here → same internal nginx proxies /api/*
#
# Build context: monorepo root (we need pnpm-workspace.yaml + packages/contracts).
# Build cmd:     docker build -f docker/Dockerfile.frontend -t scraper-frontend .

# ─── Stage: Builder ───────────────────────────────────────────────────────────
FROM node:22-alpine AS builder

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
ENV PNPM_CONFIG_PACKAGE_IMPORT_METHOD=copy \
    PNPM_CONFIG_FETCH_RETRIES=5 \
    PNPM_CONFIG_FETCH_RETRY_MAXTIMEOUT=120000 \
    PNPM_CONFIG_FETCH_TIMEOUT=300000
RUN corepack enable && corepack prepare pnpm@11 --activate

WORKDIR /app

# Copy workspace manifests, config, and workspace package.json files
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json .npmrc ./
COPY frontend/package.json ./frontend/
COPY packages/contracts/package.json ./packages/contracts/

# --ignore-scripts: packages/contracts has a "prepare" script (tsc build) that
# would run here, before its source is copied in (next COPY below), and fail
# looking for tsconfig.build.json. Same fix as Dockerfile.backend.
RUN --mount=type=cache,id=pnpm,target=/pnpm/store pnpm install --frozen-lockfile --ignore-scripts

COPY packages/contracts/ ./packages/contracts/
RUN pnpm --filter @web-scraping/contracts run build

# Production build needs the prod API base URL baked into the bundle.
# ARG + ENV pattern: pass --build-arg API_BASE_URL=https://api.tu-dominio.com
# at build time. If not provided, we fall back to the default in environment.ts.
#
# NODE_ENV=production forces Angular CLI to apply production optimizations
# (tree-shaking, AOT, no source maps) even without an explicit
# --configuration flag. The bare `ng build` (no flag) defaults to the
# production configuration in Angular 17+ anyway, but we set the env
# explicitly to make the intent obvious to anyone reading this Dockerfile.
ARG API_BASE_URL
ENV API_BASE_URL=${API_BASE_URL} \
    NODE_ENV=production

COPY frontend/ ./frontend/
RUN pnpm --filter ./frontend run build

# ─── Stage: Production (Nginx) ────────────────────────────────────────────────
FROM nginx:1.27-alpine AS production

# Drop default nginx site, replace with our static-only config
RUN rm /etc/nginx/conf.d/default.conf

# Security headers + gzip for the static SPA. This nginx only listens on
# the internal docker network; the public-facing TLS proxy lives elsewhere.
COPY docker/nginx.frontend.conf /etc/nginx/conf.d/default.conf

# Angular 22 outputs to dist/webscraper/browser (sub-path = project name).
COPY --from=builder /app/frontend/dist/webscraper/browser /usr/share/nginx/html

# Healthcheck for docker compose `depends_on: service_healthy`
#
# Why 127.0.0.1 and not localhost: on alpine, `localhost` resolves to ::1
# (IPv6) but the nginx `listen 80` directive binds to 0.0.0.0 (IPv4 only).
# wget --spider hits the wrong family and returns "Connection refused",
# making the container report (unhealthy) even though the SPA works fine.
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD wget -q --spider http://127.0.0.1/ || exit 1

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]