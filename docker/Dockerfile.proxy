# syntax=docker/dockerfile:1.4
#
# Proxy image: public nginx with envsubst for ${DOMAIN} substitution.
#
# Differs from the official nginx:1.27-alpine in two ways:
#   1. Installs `envsubst` (from the gettext package) so the entrypoint
#      can substitute ${DOMAIN} into the nginx config template.
#   2. Uses our custom entrypoint that runs envsubst then `nginx -t` then
#      `nginx -g 'daemon off;'`.

FROM nginx:1.27-alpine

# envsubst lives in the `gettext` package on alpine.
RUN apk add --no-cache gettext

# Custom entrypoint: render template → nginx -t → start in foreground.
COPY docker/proxy-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh

ENTRYPOINT ["/docker-entrypoint.sh"]