# ═══════════════════════════════════════════════════════════
#  Variables de conexión — EJEMPLO
#  Copiar a .env y ajustar según entorno:
#     cp .env.example .env
# ═══════════════════════════════════════════════════════════

# ─── PostgreSQL ─────────────────────────────────────────────
POSTGRES_DB=scraperdb
POSTGRES_USER=scraper
POSTGRES_PASSWORD=scraperpass
POSTGRES_PORT=5433                # Host port (mapea a 5432 dentro del contenedor)

# ─── Backend ────────────────────────────────────────────────
# LOCAL (fuera de Docker)
DATABASE_URL=postgresql://scraper:scraperpass@localhost:5433/scraperdb
# DOCKER (dentro del contenedor) — comentado por defecto
# DATABASE_URL=postgresql://scraper:scraperpass@postgres:5432/scraperdb

RABBITMQ_URL=amqp://scraper:scraperpass@localhost:5672
PORT=3000
NODE_ENV=development

# ─── Frontend ────────────────────────────────────────────────
BACKEND_PORT=3000
FRONTEND_PORT=8080

# ─── Auth (batch 6) ───────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-in-local-env
