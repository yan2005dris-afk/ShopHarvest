# ═══════════════════════════════════════════════════════════
#  Variables de conexión — EJEMPLO
#  Copiar a .env y ajustar según entorno:
#     cp .env.example .env
# ═══════════════════════════════════════════════════════════

# ─── PostgreSQL ─────────────────────────────────────────────
POSTGRES_DB=scraperdb
POSTGRES_USER=scraper
# POSTGRES_PASSWORD is REQUIRED — docker-compose no longer provides a
# fallback default so GitGuardian won't flag a hardcoded credential.
# Generate one with `openssl rand -hex 24` and paste it below.
POSTGRES_PASSWORD=replace-me-with-openssl-rand-hex-24
POSTGRES_PORT=5433                # Host port (mapea a 5432 dentro del contenedor)

# ─── Data Warehouse (Postgres secundario) ──────────────────
POSTGRES_DW_USER=scraper
# POSTGRES_DW_PASSWORD is REQUIRED — no fallback default for security.
POSTGRES_DW_PASSWORD=replace-me-with-openssl-rand-hex-24
POSTGRES_DW_DB=scraperdw
POSTGRES_DW_PORT=5434                # Host port (mapea a 5432 dentro del contenedor)
ANALYTICS_DATABASE_URL=postgresql://scraper:replace-me-with-openssl-rand-hex-24@localhost:5434/scraperdw
# DOCKER (dentro del contenedor) — comentado por defecto
# ANALYTICS_DATABASE_URL=postgresql://scraper:<pass>@postgres-dw:5432/scraperdw

# ─── Backend ────────────────────────────────────────────────
# LOCAL (fuera de Docker)
DATABASE_URL=postgresql://scraper:replace-me-with-openssl-rand-hex-24@localhost:5433/scraperdb
# DOCKER (dentro del contenedor) — comentado por defecto
# DATABASE_URL=postgresql://scraper:replace-me-with-openssl-rand-hex-24@postgres:5432/scraperdb

# RABBITMQ — opcional, solo si usás colas. La contraseña DEBE coincidir con la de RabbitMQ.
RABBITMQ_URL=amqp://scraper:replace-me-with-rabbitmq-password@localhost:5672
PORT=3000
NODE_ENV=development

# ─── Frontend ────────────────────────────────────────────────
BACKEND_PORT=3000
FRONTEND_PORT=8080

# ─── Auth (batch 6) ───────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-in-local-env

# ─── ETL worker (etl-integration-strategy, PR 1) ───────────────
ETL_CRON_SCHEDULE=0 2 * * *          # 02:00 UTC daily
ETL_LOG_LEVEL=info

# ═══════════════════════════════════════════════════════════
#  PRODUCTION (used by compose.yaml + vps-init.sh)
# ═══════════════════════════════════════════════════════════

# ─── Cloudflare Tunnel ─────────────────────────────────────
# Get TUNNEL_TOKEN from `cloudflared tunnel create scraper-bi`
# on your local machine. The token is the UUID of the tunnel.
#
# Ingress rules (what hostname → what service) are configured
# in the Cloudflare dashboard:
#   Zero Trust → Networks → Tunnels → your tunnel → Public Hostname
# cloudflared fetches the routing config from Cloudflare's edge on
# connect, so you do NOT need a config.yml in the container.
#
# Leave TUNNEL_TOKEN empty during initial setup — the rest of the
# stack still starts and you can verify locally on :8080. cloudflared
# will keep restarting until you set this and re-run `docker compose
# up -d cloudflared`.
TUNNEL_TOKEN=

# FRONTEND_ORIGIN is the CORS whitelist (comma-separated origins).
# Read by backend/src/main.ts enableCors(). MUST include the public
# hostname served by the Cloudflare Tunnel — otherwise the browser's
# Authorization-bearing requests get rejected with HTTP 500
# ("Not allowed by CORS").
#
# Default: localhost dev origins. For prod with a tunnel, ADD your
# public hostname to the list.
FRONTEND_ORIGIN=https://bi.example.com,http://localhost:8080,http://localhost:4200

# API_BASE_URL — what gets baked into the Angular bundle at build time.
# Use "/api" so the SPA calls the same origin via the tunnel.
API_BASE_URL=/api
