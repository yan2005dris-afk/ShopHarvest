# ─── PostgreSQL ─────────────────────────────────
POSTGRES_DB=scraperdb
POSTGRES_USER=scraper
POSTGRES_PASSWORD=scraperpass
POSTGRES_PORT=5432

# ─── RabbitMQ ───────────────────────────────────
RABBITMQ_USER=scraper
RABBITMQ_PASS=scraperpass
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# ─── Backend / Entorno ─────────────────────────
# Local (Prisma fuera de Docker)
DATABASE_URL=postgresql://scraper:scraperpass@localhost:5432/scraperdb
# Docker (backend dentro del contenedor):
# DATABASE_URL=postgresql://scraper:scraperpass@postgres:5432/scraperdb

RABBITMQ_URL=amqp://scraper:scraperpass@localhost:5672
# Docker:
# RABBITMQ_URL=amqp://scraper:scraperpass@rabbitmq:5672

NODE_ENV=development
PORT=3000
BACKEND_PORT=3000
FRONTEND_PORT=8080

# ─── CAPTCHA & Evasión ─────────────────────────
# Obtener API Key de 2Captcha, Anti-Captcha o CapMonster
CAPTCHA_SOLVER_API_KEY=your_api_key_here

# Proxy Residencial (Ej: http://user:pass@proxy.provider.com:8080)
PROXY_URL=

