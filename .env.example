# ─── PostgreSQL ─────────────────────────────────
POSTGRES_DB=scraperdb
POSTGRES_USER=scraper
POSTGRES_PASSWORD=scraperpass
POSTGRES_PORT=5432

# ─── Backend / Entorno ─────────────────────────
# Local (Prisma fuera de Docker)
DATABASE_URL=postgresql://scraper:scraperpass@localhost:5432/scraperdb
# Docker (backend dentro del contenedor):
# DATABASE_URL=postgresql://scraper:scraperpass@postgres:5432/scraperdb

NODE_ENV=development
PORT=3000
BACKEND_PORT=3000
FRONTEND_PORT=8080
