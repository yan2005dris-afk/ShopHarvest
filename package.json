{
  "name": "webscraper-etl",
  "private": true,
  "version": "0.0.1",
  "description": "Plataforma ETL semi-automatizada para extracción visual de datos en e-commerce",
  "scripts": {
    "dev:backend": "pnpm --filter backend dev",
    "dev:frontend": "pnpm --filter ./frontend start",
    "dev:worker": "pnpm --filter worker dev",
    "build:backend": "pnpm --filter backend build",
    "build:frontend": "pnpm --filter ./frontend build",
    "build:worker": "pnpm --filter worker build",
    "prisma:generate": "pnpm --filter backend prisma generate",
    "prisma:push": "pnpm --filter backend prisma db push",
    "prisma:migrate": "pnpm --filter backend prisma migrate dev",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  }
}
