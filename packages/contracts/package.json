{
  "name": "@web-scraping/contracts",
  "version": "0.1.0",
  "description": "Shared DTOs and types for the WebScrapingDinamico monorepo.",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist-cjs/index.js",
      "default": "./dist/index.js"
    },
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "import": "./dist/auth/index.js",
      "require": "./dist-cjs/auth/index.js",
      "default": "./dist/auth/index.js"
    },
    "./domains": {
      "types": "./dist/domains/index.d.ts",
      "import": "./dist/domains/index.js",
      "require": "./dist-cjs/domains/index.js",
      "default": "./dist/domains/index.js"
    },
    "./products": {
      "types": "./dist/products/index.d.ts",
      "import": "./dist/products/index.js",
      "require": "./dist-cjs/products/index.js",
      "default": "./dist/products/index.js"
    },
    "./errors": {
      "types": "./dist/errors/index.d.ts",
      "import": "./dist/errors/index.js",
      "require": "./dist-cjs/errors/index.js",
      "default": "./dist/errors/index.js"
    },
    "./analytics": {
      "types": "./dist/analytics/index.d.ts",
      "import": "./dist/analytics/index.js",
      "require": "./dist-cjs/analytics/index.js",
      "default": "./dist/analytics/index.js"
    },
    "./pipeline": {
      "types": "./dist/pipeline/index.d.ts",
      "import": "./dist/pipeline/index.js",
      "require": "./dist-cjs/pipeline/index.js",
      "default": "./dist/pipeline/index.js"
    }
  },
  "files": ["dist", "dist-cjs", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.build.cjs.json && node -e \"require('fs').writeFileSync('dist-cjs/package.json', JSON.stringify({ type: 'commonjs' }))\"",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist dist-cjs",
    "test": "jest",
    "prepare": "node -e \"if (require('fs').existsSync('tsconfig.build.json')) require('child_process').execSync('pnpm run build', { stdio: 'inherit' })\""
  },
  "peerDependencies": {
    "@nestjs/swagger": "^11.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.0"
  },
  "dependencies": {
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.0"
  },
  "devDependencies": {
    "@nestjs/swagger": "^11.4.5",
    "@types/jest": "^30.0.0",
    "jest": "^30.0.0",
    "reflect-metadata": "^0.2.2",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.3"
  }
}
