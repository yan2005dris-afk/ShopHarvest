# ═══════════════════════════════════════════════════════════
#  EJEMPLO — La configuración real está en el .env de la raíz
#  Todas las variables de conexión viven en:
#     ../.env  (raíz del proyecto)
#
#  Para arrancar:
#     cp ../.env.example ../.env   (solo la primera vez)
#     pnpm dev:backend
# ═══════════════════════════════════════════════════════════

# ─── PostgreSQL ─────────────────────────────────
DATABASE_URL=postgresql://scraper:scraperpass@localhost:5433/scraperdb

# ─── RabbitMQ ───────────────────────────────────
RABBITMQ_URL=amqp://scraper:scraperpass@localhost:5672

# ─── Backend ───────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Pipeline consolidation (PR 1b+) ─────────────
# Output paths for raw and staging data
PIPELINE_RAW_DIR=backend/pipeline/raw
PIPELINE_STAGING_DIR=backend/pipeline/staging

# Extension-based sources (Temu/Shein) read from this file
EXTENSION_EXPORT_PATH=backend/pipeline/extension/extension_export.json

# Browser factory (PR 2 — added in 1b for forward-compat)
# Stealth is always on. Proxy is opt-in via SCRAPER_PROXY_SERVER.
SCRAPER_PROXY_SERVER=
SCRAPER_PROXY_USERNAME=
SCRAPER_PROXY_PASSWORD=
SCRAPER_HEADLESS=true
