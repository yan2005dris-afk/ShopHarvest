{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "noFallthroughCasesInSwitch": true
  },
  // Cambio SDD: bi-dashboard-analytics. Excluir pipeline/ del tsc del
  // backend porque los scripts ETL tienen sus propias deps (Playwright,
  // axios, csv-parse) que NO son deps del backend. El pipeline vive
  // bajo backend/pipeline/ pero mantiene su propio tsconfig y package.json.
  "exclude": ["pipeline/**", "node_modules", "dist"]
}
