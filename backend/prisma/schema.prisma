// ─── Prisma Schema ───────────────────────────────────────────────────────
// Single source of truth. Edit this file directly; do NOT split it across
// multiple files (a previous attempt at a `schema/models/` directory was
// removed in batch 2 — it was never wired into a generator and produced
// drift between source and generated client types).

// Generator & Datasource
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider = "postgresql"
}

// ─── Models ──────────────────────────────────────────────────────────────
// DomainRule — Reglas de extracción por dominio
model DomainRule {
  id              String   @id @default(uuid()) @db.Uuid
  domain          String   @unique
  name            String

  // Single source of truth for extraction rules. The visual mapper writes
  // here; the ingest endpoint reads from here. Legacy `selectorTitle/Price/
  // Image/Sku/Type` columns were dropped in batch 2.
  fieldMappings       Json?
  containerSelector   String?
  productLimit        Int?

  // Pagination metadata — kept because batch 5 (auto-replay with scroll)
  // will use these.
  paginationType  String   @default("scroll")
  paginationSelector String?

  sampleUrl       String?
  lastScrapedAt   DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  products        Product[]
}

// Product — Datos normalizados extraídos
model Product {
  id          String   @id @default(uuid()) @db.Uuid
  domainRuleId String  @db.Uuid
  domainRule  DomainRule @relation(fields: [domainRuleId], references: [id])

  externalId  String?
  title       String
  price       Decimal  @db.Decimal(12, 2)
  currency    String   @default("USD")
  imageUrl    String?
  productUrl  String
  sku         String?
  description String?

  rawData     Json?
  extractedAt DateTime @default(now())

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  priceHistory PriceHistory[]

  @@index([domainRuleId])
  @@index([externalId])
  @@index([productUrl])
}

// PriceHistory — Historial de precios
model PriceHistory {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @db.Uuid
  product   Product  @relation(fields: [productId], references: [id])

  price     Decimal  @db.Decimal(12, 2)
  currency  String   @default("USD")
  capturedAt DateTime @default(now())

  createdAt DateTime @default(now())

  @@index([productId])
  @@index([capturedAt])
}

// ScrapingJob and ScrapingSchedule models were removed in review batch 4. The
// headless worker they fed no longer exists; automated re-scraping now runs in
// the extension via chrome.alarms (batch 5). See migration
// 20260704020000_drop_scraping_jobs_schedules.

// User — authentication (review batch 6, C2). JWT-based per-user auth gates the
// API so arbitrary extensions can no longer POST/DELETE.
model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ─── ETL integration (change: etl-integration-strategy, PR 1) ──────────────
// The ETL worker process writes run history, scraped products, and quality
// metrics here. Idempotency is enforced by the @@unique([source, sourceId])
// constraint on EtlProduct — re-running the scraper upserts by composite key.

enum EtlRunStatus {
  RUNNING
  SUCCESS
  FAILED
}

model EtlRun {
  id            String        @id @default(uuid()) @db.Uuid
  source        String
  status        EtlRunStatus  @default(RUNNING)
  startedAt     DateTime      @default(now())
  finishedAt    DateTime?
  rowsScraped   Int           @default(0)
  rowsPersisted Int           @default(0)
  errorSummary  String?
  etlProducts   EtlProduct[]
  qualityMetric QualityMetric?

  @@index([status, startedAt(sort: Desc)])
}

model EtlProduct {
  id           String   @id @default(uuid()) @db.Uuid
  etlRunId     String   @db.Uuid
  etlRun       EtlRun   @relation(fields: [etlRunId], references: [id])
  source       String
  sourceId     String
  title        String
  price        Decimal? @db.Decimal(12, 2)
  currency     String   @default("GBP")
  availability String?
  rawJson      Json
  scrapedAt    DateTime

  @@unique([source, sourceId])
  @@index([etlRunId])
  @@index([sourceId])
}

model QualityMetric {
  id                String   @id @default(uuid()) @db.Uuid
  etlRunId          String   @unique @db.Uuid
  etlRun            EtlRun   @relation(fields: [etlRunId], references: [id])
  completenessPct   Decimal  @db.Decimal(5, 2)
  duplicatesRemoved Int      @default(0)
  checks            Json
}
