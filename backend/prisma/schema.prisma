// ─── Prisma Schema ───────────────────────────────────────────────────────
// Single source of truth. Edit this file directly; do NOT split it across
// multiple files (a previous attempt at a `schema/models/` directory was
// removed in batch 2 — it was never wired into a generator and produced
// drift between source and generated client types).

// Generator & Datasource
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider = "postgresql"
}

// ─── Models ──────────────────────────────────────────────────────────────
// DomainRule — Reglas de extracción por dominio
model DomainRule {
  id              String   @id @default(uuid()) @db.Uuid
  domain          String   @unique
  name            String

  // Single source of truth for extraction rules. The visual mapper writes
  // here; the ingest endpoint reads from here. Legacy `selectorTitle/Price/
  // Image/Sku/Type` columns were dropped in batch 2.
  fieldMappings       Json?
  containerSelector   String?
  productLimit        Int?

  // Pagination metadata — kept because batch 5 (auto-replay with scroll)
  // will use these.
  paginationType  String   @default("scroll")
  paginationSelector String?

  sampleUrl       String?
  lastScrapedAt   DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  products        Product[]
  scrapingJobs    ScrapingJob[]
  scrapingSchedules ScrapingSchedule[]
}

// Product — Datos normalizados extraídos
model Product {
  id          String   @id @default(uuid()) @db.Uuid
  domainRuleId String  @db.Uuid
  domainRule  DomainRule @relation(fields: [domainRuleId], references: [id])

  externalId  String?
  title       String
  price       Decimal  @db.Decimal(12, 2)
  currency    String   @default("USD")
  imageUrl    String?
  productUrl  String
  sku         String?
  description String?

  rawData     Json?
  extractedAt DateTime @default(now())

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  priceHistory PriceHistory[]

  @@index([domainRuleId])
  @@index([externalId])
  @@index([productUrl])
}

// PriceHistory — Historial de precios
model PriceHistory {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @db.Uuid
  product   Product  @relation(fields: [productId], references: [id])

  price     Decimal  @db.Decimal(12, 2)
  currency  String   @default("USD")
  capturedAt DateTime @default(now())

  createdAt DateTime @default(now())

  @@index([productId])
  @@index([capturedAt])
}

// ScrapingJob — Lifecycle de cada trabajo de scraping
model ScrapingJob {
  id              String    @id @default(uuid()) @db.Uuid
  domainRuleId    String    @db.Uuid
  domainRule      DomainRule @relation(fields: [domainRuleId], references: [id])

  url             String
  type            String    @default("single") // "single" | "listing"
  status          String    @default("queued")
  retryCount      Int       @default(0)
  maxRetries      Int       @default(3)
  errorMessage    String?
  result          Json?

  enqueuedAt      DateTime  @default(now())
  startedAt       DateTime?
  completedAt     DateTime?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([domainRuleId])
}

// ScrapingSchedule — Programación cron para scraping automático
model ScrapingSchedule {
  id              String    @id @default(uuid()) @db.Uuid
  domainRuleId    String    @db.Uuid
  domainRule      DomainRule @relation(fields: [domainRuleId], references: [id])

  cronExpression  String
  enabled         Boolean   @default(true)
  lastRunAt       DateTime?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([enabled])
}
