// ─── Product ───────────────────────────────────────────────────────────────
// Datos normalizados extraídos de los sitios de e-commerce.

model Product {
  id          String   @id @default(uuid()) @db.Uuid
  domainRuleId String  @db.Uuid
  domainRule  DomainRule @relation(fields: [domainRuleId], references: [id])

  // Datos extraídos
  externalId  String?  // ID del producto en la fuente original
  title       String
  price       Decimal  @db.Decimal(12, 2)
  currency    String   @default("USD")
  imageUrl    String?
  productUrl  String
  sku         String?
  description String?

  // Metadatos de extracción
  rawData     Json?    // JSON original por si necesitamos re-procesar
  extractedAt DateTime @default(now())

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  priceHistory PriceHistory[]

  @@index([domainRuleId])
  @@index([externalId])
  @@index([productUrl])
}
