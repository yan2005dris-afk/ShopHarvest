// ─── Prisma Schema — OPERATIONAL database ─────────────────────────────────
// Single source of truth for the operational (OLTP) database. Edit this file
// directly; do NOT split it across multiple files (a previous attempt at a
// `schema/models/` directory was removed in batch 2 — it was never wired into
// a generator and produced drift between source and generated client types).
//
// Split from the original single-database schema (Fase 0, docs/PLAN-Fase0-split-bases.md):
// this database only holds `public` models. The `dw` (analytics/DW) models
// live in ../analytics/schema.prisma, a physically separate Postgres instance
// (`postgres-dw`, see fix-analytics-db-wiring). This file's own `dw` schema
// duplicate — a leftover from before that fix wired the ETL/analytics
// services to the real analytics DB — was dropped in
// `chore/drop-operational-dw-schema`.

// Generator & Datasource
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres"]
  output          = "../../src/generated/operational"
}

datasource db {
  provider = "postgresql"
}

// ─── Models ──────────────────────────────────────────────────────────────
// DomainRule — Reglas de extracción por dominio
model DomainRule {
  id              String   @id @default(uuid()) @db.Uuid
  domain          String   @unique
  name            String

  categoryId      String?  @db.Uuid
  category        Category? @relation(fields: [categoryId], references: [id])

  // Single source of truth for extraction rules. The visual mapper writes
  // here; the ingest endpoint reads from here. Legacy `selectorTitle/Price/
  // Image/Sku/Type` columns were dropped in batch 2.
  fieldMappings       Json?
  containerSelector   String?
  productLimit        Int?

  // Pagination metadata — kept because batch 5 (auto-replay with scroll)
  // will use these.
  paginationType  String   @default("scroll")
  paginationSelector String?

  sampleUrl       String?
  lastScrapedAt   DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Cambio SDD: product-offer-split. Bridge to Fase1a's Source: the
  // extension only ever sends `dto.domain`, so `ingestFromExtension`
  // resolves/upserts a Source keyed by that domain and backfills this FK.
  // Nullable because pre-existing dev rows have no Source yet and there is
  // no migration-time backfill (greenfield, no production data).
  sourceId        String?  @db.Uuid
  source          Source?  @relation(fields: [sourceId], references: [id])

  offers          Offer[]
}

// Product — canonical product identity only (product-offer-split).
// Flat price/url/externalId/sku/rawData moved to Offer; price series moved
// to PriceObservation (hung off Offer). categoryId/brandId are schema-only,
// unpopulated FK columns (no auto-classification in this change).
model Product {
  id          String    @id @default(uuid()) @db.Uuid
  title       String
  description String?
  imageUrl    String?

  categoryId  String?   @db.Uuid
  brandId     String?   @db.Uuid
  category    Category? @relation(fields: [categoryId], references: [id])
  brand       Brand?    @relation(fields: [brandId], references: [id])

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  offers      Offer[]

  @@index([categoryId])
  @@index([brandId])
}

// Offer — a Product listed at a specific Source (product-at-a-site).
// 1 ingested item = 1 Offer; no cross-source dedup (product-offer-split).
model Offer {
  id           String      @id @default(uuid()) @db.Uuid
  productId    String      @db.Uuid
  product      Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  sourceId     String      @db.Uuid
  source       Source      @relation(fields: [sourceId], references: [id])

  domainRuleId String?     @db.Uuid
  domainRule   DomainRule? @relation(fields: [domainRuleId], references: [id])

  externalId   String?
  url          String
  sku          String?
  currency     String      @default("USD")
  price        Decimal     @db.Decimal(12, 2) // latest snapshot
  rawData      Json?
  extractedAt  DateTime    @default(now())

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  priceObservations PriceObservation[]
  rawCaptures       RawCapture[]

  @@unique([sourceId, url])
  @@index([productId])
  @@index([sourceId])
  @@index([externalId])
}

// PriceObservation — price-over-time series, hung off Offer (replaces
// PriceHistory, which hung off the old flat Product).
model PriceObservation {
  id         String   @id @default(uuid()) @db.Uuid
  offerId    String   @db.Uuid
  offer      Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)

  price      Decimal  @db.Decimal(12, 2)
  currency   String   @default("USD")
  observedAt DateTime @default(now())

  createdAt  DateTime @default(now())

  @@index([offerId])
  @@index([observedAt])
}

// ScrapingJob and ScrapingSchedule models were removed in review batch 4. The
// headless worker they fed no longer exists; automated re-scraping now runs in
// the extension via chrome.alarms (batch 5). See migration
// 20260704020000_drop_scraping_jobs_schedules.

// User — authentication (review batch 6, C2). JWT-based per-user auth gates the
// API so arbitrary extensions can no longer POST/DELETE.
model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ─── ETL integration (change: etl-integration-strategy, PR 1) ──────────────
// EtlRun tracks run history for the pipeline; QualityMetric its quality
// checks. EtlProduct (the standalone `worker/` package's per-row scrape
// persistence) was removed in `chore/remove-etl-product`: the `worker/`
// package that wrote to it was deleted in PR #11 (bi-dashboard-analytics)
// in favor of RawCapture + staging + PipelineModule, leaving EtlProduct with
// zero code references.

enum EtlRunStatus {
  RUNNING
  SUCCESS
  FAILED
}

model EtlRun {
  id            String        @id @default(uuid()) @db.Uuid
  source        String
  status        EtlRunStatus  @default(RUNNING)
  startedAt     DateTime      @default(now())
  finishedAt    DateTime?
  rowsScraped   Int           @default(0)
  rowsPersisted Int           @default(0)
  errorSummary  String?
  qualityMetric QualityMetric?

  @@index([status, startedAt(sort: Desc)])
  @@index([source])
}

model QualityMetric {
  id                String   @id @default(uuid()) @db.Uuid
  etlRunId          String   @unique @db.Uuid
  etlRun            EtlRun   @relation(fields: [etlRunId], references: [id])
  completenessPct   Decimal  @db.Decimal(5, 2)
  duplicatesRemoved Int      @default(0)
  checks            Json
}

// ─── Fase 1a — Modelo Operacional ──────────────────────────────────────────
// Source, Category, Brand, and RawCapture entities for structured scraping
// source management. Added in PR 1 of the 3-slice feature-branch chain.

enum SourceStatus {
  inactive
  active
  error

  @@map("source_status")
}

model Source {
  id        String       @id @default(uuid()) @db.Uuid
  code      String       @unique
  name      String
  baseUrl   String
  status    SourceStatus @default(inactive)
  config    Json?        @db.JsonB
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  categories CategorySourceMapping[]
  rawCaptures RawCapture[]

  // Cambio SDD: product-offer-split — bridge relations for the
  // DomainRule → Source resolution (Decision 1) and Offer.sourceId FK.
  domainRules DomainRule[]
  offers      Offer[]

  @@map("sources")
}

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  description String?
  defaultFieldMappings Json?

  // Legacy tree fields kept for backward compat with CategorySourceMapping
  parentId  String?  @db.Uuid
  path      String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent     Category?              @relation("CategoryTree", fields: [parentId], references: [id])
  children   Category[]             @relation("CategoryTree")
  mappings   CategorySourceMapping[]

  products   Product[]
  domainRules DomainRule[]

  @@index([parentId])
  @@index([path])
  @@map("categories")
}

model CategorySourceMapping {
  categoryId String @db.Uuid
  sourceId   String @db.Uuid
  remoteCode String

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  source   Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@id([categoryId, sourceId])
  @@map("category_source_mappings")
}

model Brand {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  aliases   String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Cambio SDD: product-offer-split — unpopulated back-relation for
  // Product.brandId (schema-only FK, no auto-classification).
  products  Product[]

  @@index([aliases], type: Gin)
  @@map("brands")
}

model RawCapture {
  offerId    String   @db.Uuid
  sourceId   String   @db.Uuid
  payload    Json     @db.JsonB
  capturedAt DateTime @default(now()) @db.Timestamp(6)

  source Source @relation(fields: [sourceId], references: [id])
  // Cambio SDD: product-offer-split — real FK, closing the orphan-model
  // gap flagged in exploration.md (offerId was previously a bare String
  // with no referential integrity).
  offer  Offer  @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@id([offerId, sourceId])
  @@index([capturedAt])
  @@map("raw_captures")
}
