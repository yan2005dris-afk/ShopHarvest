{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2020", "DOM"],
    "outDir": "./dist",
    "rootDir": "./",
    "baseUrl": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "paths": {
      "@web-scraping/contracts/*": ["../../packages/contracts/dist/*"],
      "@web-scraping/contracts": ["../../packages/contracts/dist/index"]
    }
  },
  "include": ["scripts/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
