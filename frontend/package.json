{
  "name": "webscraper",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build:css": "tailwindcss -i src/styles.css -o src/styles.built.css",
    "watch:css": "tailwindcss -i src/styles.css -o src/styles.built.css --watch",
    "build": "pnpm build:css && ng build",
    "watch": "pnpm watch:css & ng build --watch --configuration development",
    "test": "pnpm build:css && ng test"
  },
  "private": true,
  "packageManager": "pnpm@11.1.1",
  "dependencies": {
    "@angular/animations": "^20.1.8",
    "@angular/cdk": "^22.1.1",
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/material": "^22.1.1",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@web-scraping/contracts": "workspace:*",
    "apexcharts": "^5.16.0",
    "boneyard-js": "^1.9.0",
    "ng-apexcharts": "^2.4.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.6.2",
    "@angular/build": "^22.0.1",
    "@angular/cli": "^22.0.1",
    "@angular/compiler-cli": "^22.0.0",
    "@angular/localize": "^22.0.5",
    "@tailwindcss/cli": "^4.3.2",
    "@types/chrome": "^0.0.260",
    "@types/node": "^24.13.2",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.19",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.3.2",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
